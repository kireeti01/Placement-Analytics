import React, { useState } from 'react';
import { FaPlus, FaUpload, FaEdit, FaTrash, FaSave, FaTimes, FaDownload } from 'react-icons/fa';
import toast from 'react-hot-toast';
import Papa from 'papaparse';
import { useAppContext } from '../context/AppContext';

const StudentManagement = () => {
  const { students, addStudent, addBulkStudents, updateStudent, deleteStudent, loading, loadStudents, loadStats } = useAppContext();
  const [showForm, setShowForm] = useState(false);
  const [editingStudent, setEditingStudent] = useState(null);
  const [isUploading, setIsUploading] = useState(false);
  const [formData, setFormData] = useState({
    name: '',
    roll_number: '',
    branch: '',
    cgpa: '',
    placement_status: 'in_process',
    company: '',
    package: ''
  });

  const branches = ['CSE', 'ECE', 'EEE', 'Mechanical', 'Civil', 'IT', 'Chemical'];
  const statuses = ['placed', 'unplaced', 'at_risk', 'in_process'];

  // ============================================================
  // CSV UPLOAD HANDLER - CORRECT VERSION
  // ============================================================
  const handleCSVUpload = (event) => {
    const file = event.target.files[0];
    if (!file) {
      toast.error('No file selected');
      return;
    }

    if (!file.name.endsWith('.csv')) {
      toast.error('Please upload a CSV file');
      event.target.value = '';
      return;
    }

    if (file.size > 5 * 1024 * 1024) {
      toast.error('File size too large. Maximum 5MB allowed.');
      event.target.value = '';
      return;
    }

    setIsUploading(true);
    const loadingToast = toast.loading('⏳ Processing CSV file...');

    Papa.parse(file, {
      header: true,
      skipEmptyLines: true,
      trimHeaders: true,
      transformHeader: (header) => {
        const headerMap = {
          'name': 'name',
          'Name': 'name',
          'NAME': 'name',
          'roll number': 'roll_number',
          'roll_number': 'roll_number',
          'Roll Number': 'roll_number',
          'ROLL NUMBER': 'roll_number',
          'roll': 'roll_number',
          'Roll': 'roll_number',
          'branch': 'branch',
          'Branch': 'branch',
          'BRANCH': 'branch',
          'cgpa': 'cgpa',
          'CGPA': 'cgpa',
          'Cgpa': 'cgpa',
          'placement status': 'placement_status',
          'placement_status': 'placement_status',
          'Placement Status': 'placement_status',
          'PLACEMENT STATUS': 'placement_status',
          'status': 'placement_status',
          'Status': 'placement_status',
          'company': 'company',
          'Company': 'company',
          'COMPANY': 'company',
          'package': 'package',
          'Package': 'package',
          'PACKAGE': 'package',
          'package (lpa)': 'package',
          'Package (LPA)': 'package',
          'PACKAGE (LPA)': 'package',
          'email': 'email',
          'Email': 'email',
          'phone': 'phone',
          'Phone': 'phone',
          'batch': 'batch',
          'Batch': 'batch'
        };
        return headerMap[header.trim()] || header.trim().toLowerCase().replace(/ /g, '_');
      },
      complete: async (results) => {
        toast.dismiss(loadingToast);
        setIsUploading(false);
        
        console.log('📊 CSV Parse Results:', {
          totalRows: results.data.length,
          fields: results.meta.fields,
          sampleData: results.data.slice(0, 3)
        });

        const studentsData = results.data
          .filter(row => row.name && row.name.toString().trim() !== '')
          .map(row => ({
            name: row.name?.toString().trim() || '',
            roll_number: row.roll_number?.toString().trim() || '',
            branch: row.branch?.toString().trim() || '',
            cgpa: parseFloat(row.cgpa) || '',
            placement_status: row.placement_status?.toString().trim() || 'in_process',
            company: row.company?.toString().trim() || '',
            package: row.package?.toString().trim() || '',
            email: row.email?.toString().trim() || '',
            phone: row.phone?.toString().trim() || '',
            batch: row.batch?.toString().trim() || '2025'
          }));

        console.log(`📊 Parsed ${studentsData.length} students from CSV`);

        if (studentsData.length === 0) {
          toast.error('No valid student data found in CSV. Please check the format.');
          event.target.value = '';
          return;
        }

        try {
          const response = await addBulkStudents(studentsData);
          console.log('✅ Bulk upload response:', response);
          
          if (response && response.success > 0) {
            toast.success(`✅ ${response.success} students added successfully!`);
          }
          if (response && response.failed > 0) {
            toast.error(`❌ ${response.failed} students failed to add`);
            if (response.errors) {
              response.errors.forEach(err => {
                console.error(`Row ${err.row}:`, err.error);
              });
            }
          }
        } catch (error) {
          console.error('❌ Bulk upload error:', error);
          toast.error('❌ ' + (error.response?.data?.error || 'Failed to upload students'));
        }

        event.target.value = '';
      },
      error: (error) => {
        toast.dismiss(loadingToast);
        setIsUploading(false);
        console.error('❌ CSV Parse Error:', error);
        toast.error('Error reading CSV file: ' + error.message);
        event.target.value = '';
      }
    });
  };

  // ============================================================
  // DOWNLOAD TEMPLATE
  // ============================================================
  const downloadTemplate = () => {
    const headers = ['Name', 'Roll Number', 'Branch', 'CGPA', 'Placement Status', 'Company', 'Package (LPA)'];
    const csvContent = headers.join(',');
    const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'Student_Data_Template.csv';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    toast.success('📥 Template downloaded!');
  };

  // ============================================================
  // FORM HANDLERS
  // ============================================================
  const handleInputChange = (e) => {
    setFormData({ ...formData, [e.target.name]: e.target.value });
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    
    if (!formData.name || !formData.roll_number || !formData.branch) {
      toast.error('Please fill all required fields');
      return;
    }

    const studentData = {
      ...formData,
      cgpa: parseFloat(formData.cgpa) || 0
    };

    if (editingStudent) {
      await updateStudent(editingStudent.id, studentData);
    } else {
      await addStudent(studentData);
    }

    resetForm();
  };

  const resetForm = () => {
    setFormData({ 
      name: '', 
      roll_number: '', 
      branch: '', 
      cgpa: '', 
      placement_status: 'in_process', 
      company: '', 
      package: '' 
    });
    setEditingStudent(null);
    setShowForm(false);
  };

  const handleEdit = (student) => {
    setEditingStudent(student);
    setFormData({
      name: student.name || '',
      roll_number: student.roll_number || '',
      branch: student.branch || '',
      cgpa: student.cgpa || '',
      placement_status: student.placement_status || 'in_process',
      company: student.company || '',
      package: student.package || ''
    });
    setShowForm(true);
  };

  const handleDelete = async (id) => {
    if (window.confirm('Are you sure you want to delete this student?')) {
      await deleteStudent(id);
    }
  };

  const getStatusLabel = (status) => {
    const labels = {
      placed: 'Placed',
      unplaced: 'Unplaced',
      at_risk: 'At Risk',
      in_process: 'In Process'
    };
    return labels[status] || status;
  };

  const getStatusBadge = (status) => {
    if (status === 'placed') return 'badge-success';
    if (status === 'unplaced') return 'badge-warning';
    if (status === 'at_risk') return 'badge-danger';
    return 'badge-info';
  };

  return (
    <div className="dashboard-section active">
      <div className="ai-insights-banner">
        <h2>📋 Student Management</h2>
        <p>Add, edit, and manage student placement data</p>
        <div style={{ display: 'flex', gap: '16px', marginTop: '12px' }}>
          <span style={{ background: 'rgba(255,255,255,0.2)', padding: '6px 16px', borderRadius: '20px', fontSize: '13px' }}>
            Total: {students.length}
          </span>
          <span style={{ background: 'rgba(40,167,69,0.3)', padding: '6px 16px', borderRadius: '20px', fontSize: '13px' }}>
            Placed: {students.filter(s => s.placement_status === 'placed').length}
          </span>
          <span style={{ background: 'rgba(255,193,7,0.3)', padding: '6px 16px', borderRadius: '20px', fontSize: '13px' }}>
            Unplaced: {students.filter(s => s.placement_status === 'unplaced').length}
          </span>
          <span style={{ background: 'rgba(220,53,69,0.3)', padding: '6px 16px', borderRadius: '20px', fontSize: '13px' }}>
            At Risk: {students.filter(s => s.placement_status === 'at_risk').length}
          </span>
        </div>
      </div>

      <div style={{ display: 'flex', gap: '10px', flexWrap: 'wrap', marginBottom: '20px' }}>
        <button className="btn btn-primary" onClick={() => { resetForm(); setShowForm(true); }} disabled={loading}>
          <FaPlus /> Add Student
        </button>
        <button className="btn btn-outline" onClick={downloadTemplate} disabled={loading}>
          <FaDownload /> Download Template
        </button>
        <label className="btn btn-primary" style={{ 
          cursor: isUploading ? 'not-allowed' : 'pointer',
          background: isUploading ? 'var(--warning)' : 'var(--success)',
          opacity: isUploading ? 0.7 : 1
        }}>
          {isUploading ? '⏳ Uploading...' : <><FaUpload /> Upload CSV</>}
          <input type="file" accept=".csv" onChange={handleCSVUpload} style={{ display: 'none' }} disabled={isUploading || loading} />
        </label>
        <span style={{ fontSize: '13px', color: '#6c757d', alignSelf: 'center', marginLeft: 'auto' }}>
          {students.length} students | Placed: {students.filter(s => s.placement_status === 'placed').length}
        </span>
      </div>

      <div style={{ 
        background: '#f8f9fa', 
        padding: '10px 16px', 
        borderRadius: '8px', 
        marginBottom: '16px',
        fontSize: '13px',
        color: '#6c757d',
        display: 'flex',
        alignItems: 'center',
        gap: '8px',
        flexWrap: 'wrap'
      }}>
        <span>💡</span>
        <span><strong>CSV Format:</strong></span>
        <span>Name, Roll Number, Branch (Required)</span>
        <span style={{ color: '#adb5bd' }}>|</span>
        <span>CGPA, Status, Company, Package (Optional)</span>
        <span style={{ color: '#adb5bd' }}>|</span>
        <span style={{ color: 'var(--success)' }}>✓ Download template for exact format</span>
      </div>

      {showForm && (
        <div className="chart-card" style={{ marginBottom: '20px' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '16px' }}>
            <h3>{editingStudent ? '✏️ Edit Student' : '➕ Add New Student'}</h3>
            <button className="btn btn-outline" onClick={resetForm} style={{ padding: '6px 12px' }}>
              <FaTimes /> Cancel
            </button>
          </div>
          <form onSubmit={handleSubmit}>
            <div className="form-row">
              <div className="form-group">
                <label>Full Name *</label>
                <input type="text" name="name" value={formData.name} onChange={handleInputChange} placeholder="Enter student name" required disabled={loading} />
              </div>
              <div className="form-group">
                <label>Roll Number *</label>
                <input type="text" name="roll_number" value={formData.roll_number} onChange={handleInputChange} placeholder="e.g., 20CS101" required disabled={loading} />
              </div>
            </div>
            <div className="form-row">
              <div className="form-group">
                <label>Branch *</label>
                <select name="branch" value={formData.branch} onChange={handleInputChange} required disabled={loading}>
                  <option value="">Select Branch</option>
                  {branches.map(b => <option key={b} value={b}>{b}</option>)}
                </select>
              </div>
              <div className="form-group">
                <label>CGPA</label>
                <input type="number" name="cgpa" step="0.1" min="0" max="10" value={formData.cgpa} onChange={handleInputChange} placeholder="e.g., 8.5" disabled={loading} />
              </div>
            </div>
            <div className="form-row">
              <div className="form-group">
                <label>Placement Status</label>
                <select name="placement_status" value={formData.placement_status} onChange={handleInputChange} disabled={loading}>
                  {statuses.map(s => <option key={s} value={s}>{getStatusLabel(s)}</option>)}
                </select>
              </div>
              <div className="form-group">
                <label>Company</label>
                <input type="text" name="company" value={formData.company} onChange={handleInputChange} placeholder="Company name" disabled={loading} />
              </div>
            </div>
            <div className="form-row">
              <div className="form-group">
                <label>Package (LPA)</label>
                <input type="text" name="package" value={formData.package} onChange={handleInputChange} placeholder="e.g., 8.5" disabled={loading} />
              </div>
            </div>
            <button type="submit" className="btn btn-primary" style={{ width: '100%', padding: '14px' }} disabled={loading}>
              <FaSave /> {editingStudent ? 'Update Student' : 'Add Student'}
            </button>
          </form>
        </div>
      )}

      <div className="table-card">
        <div className="table-header">
          <h3>📊 Student Records ({students.length})</h3>
        </div>
        <div style={{ overflowX: 'auto' }}>
          <table className="data-table" style={{ minWidth: '1100px' }}>
            <thead>
              <tr>
                <th>#</th>
                <th style={{ minWidth: '200px' }}>Name</th>
                <th style={{ minWidth: '120px' }}>Roll</th>
                <th>Branch</th>
                <th>CGPA</th>
                <th style={{ minWidth: '110px' }}>Status</th>
                <th>Company</th>
                <th>Package</th>
                <th style={{ minWidth: '100px' }}>Actions</th>
              </tr>
            </thead>
            <tbody>
              {students.length === 0 ? (
                <tr>
                  <td colSpan="9" style={{ textAlign: 'center', padding: '40px', color: '#6c757d' }}>
                    <div style={{ fontSize: '48px', marginBottom: '10px' }}>📭</div>
                    No students added yet. Click "Add Student" or "Upload CSV" to get started.
                  </td>
                </tr>
              ) : (
                students.map((student, index) => (
                  <tr key={student.id}>
                    <td>{index + 1}</td>
                    <td style={{ minWidth: '200px', maxWidth: '280px' }}>
                      <strong style={{ display: 'inline-block', whiteSpace: 'normal', overflowWrap: 'anywhere', wordBreak: 'break-word' }}>
                        {student.name}
                      </strong>
                    </td>
                    <td style={{ minWidth: '120px' }}>{student.roll_number}</td>
                    <td>{student.branch}</td>
                    <td>{student.cgpa || '-'}</td>
                    <td style={{ minWidth: '110px' }}>
                      <span className={'badge ' + getStatusBadge(student.placement_status)}>
                        {getStatusLabel(student.placement_status)}
                      </span>
                    </td>
                    <td>{student.company || '-'}</td>
                    <td>{student.package || '-'}</td>
                    <td style={{ minWidth: '100px' }}>
                      <button className="btn btn-outline" style={{ padding: '4px 8px', marginRight: '6px' }} onClick={() => handleEdit(student)} disabled={loading} title="Edit">
                        <FaEdit />
                      </button>
                      <button className="btn btn-outline" style={{ padding: '4px 8px', color: 'var(--danger)' }} onClick={() => handleDelete(student.id)} disabled={loading} title="Delete">
                        <FaTrash />
                      </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
};

export default StudentManagement;